{
  "name": "@sampleflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/**/*.integration.test.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "dev:seed": "tsx src/cli/seed.ts",
    "admin:bootstrap": "tsx src/cli/bootstrap-admin.ts",
    "import:preflight": "tsx src/cli/import-legacy.ts",
    "import:confirm": "tsx src/cli/confirm-import.ts",
    "organization:preflight": "tsx src/cli/preflight-organization.ts",
    "auth:cleanup-sessions": "tsx src/cli/cleanup-sessions.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12"
  }
}
